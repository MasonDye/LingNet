{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灵网-河南经贸校园网专版",
  "version": "0.1.4",
  "identifier": "com.lingnet.hnjm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "灵网登录器",
        "width": 360,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https://lingnet.voxtal.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "灵网登录器",
    "longDescription": "灵网 · 河南经贸校园网专版：SRun 认证一键 / 自动登录，支持 WiFi/有线识别与开机自启。",
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": ["zh-CN"]
      }
    }
  }
}
